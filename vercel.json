{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "installCommand": "npm install --legacy-peer-deps",
    "buildCommand": "npm run build",
    "functions": {
        "api/index.js": {
            "includeFiles": "dist/**"
        }
    },
    "rewrites": [
        {
            "source": "/(.*)",
            "destination": "/api"
        }
    ]
}
