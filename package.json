{
    "name": "chep-server",
    "version": "1.0.0",
    "description": "",
    "type": "module",
    "scripts": {
        "prepare": "husky",
        "test": "vitest",
        "test:coverage": "vitest run --coverage",
        "lint": "eslint . --fix",
        "format": "prettier --write .",
        "dev": "npx nodemon src/main.*",
        "dev:local": "npx nodemon src/dev.*",
        "start": "vercel dev",
        "build:ts": "rimraf dist && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json --resolve-full-paths --resolve-full-extension .js",
        "build": "npm run build:ts && node scripts/build.*",
        "generate-module": "node scripts/generate-module.*"
    },
    "author": "dongntd",
    "license": "ISC",
    "dependencies": {
        "@faker-js/faker": "^10.5.0",
        "bcryptjs": "^3.0.3",
        "chalk": "^6.0.0",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.6",
        "cross-env": "^10.1.0",
        "dotenv": "^17.4.2",
        "express": "^5.2.1",
        "http-status-codes": "^2.3.0",
        "https": "^1.0.0",
        "jsonwebtoken": "^9.0.3",
        "mongodb": "^7.5.0",
        "mongoose": "^9.8.1",
        "morgan": "^1.11.0",
        "nodemailer": "^9.0.3",
        "pusher": "^5.3.4",
        "socket.io": "^4.8.3",
        "uuid": "^14.0.1"
    },
    "devDependencies": {
        "@commitlint/cli": "^21.2.1",
        "@commitlint/config-conventional": "^21.2.0",
        "@eslint/js": "^10.0.1",
        "@tsconfig/node24": "^24.0.4",
        "@types/cookie-parser": "^1.4.10",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/express-serve-static-core": "^5.1.2",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/morgan": "^1.9.10",
        "@types/multer": "^2.2.0",
        "@types/node": "^26.1.2",
        "@types/nodemailer": "^8.0.1",
        "@types/supertest": "^7.2.1",
        "@typescript-eslint/parser": "^8.65.0",
        "@vercel/node": "^5.9.0",
        "@vitest/coverage-c8": "^0.33.0",
        "copyfiles": "^2.4.1",
