        "supertest": "^7.2.2",
        "ts-node": "^10.9.2",
        "tsc-alias": "^1.9.1",
        "tsconfig-paths": "^4.2.0",
        "tsx": "^4.23.1",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.65.0",
        "vite-tsconfig-paths": "^6.1.1",
        "vitest": "^4.1.10"
